<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ライトテーマ：WebView の prefers-color-scheme も light になる -->
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">#F3F6F5</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">#F3F6F5</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">@color/paper</item>
    </style>
    <color name="paper">#F3F6F5</color>
</resources>
